#include<stdio.h>
struct student
{
    int roll_number;
    char name[20];
    float mark;
}r;
void savestudent();
void displaystudent();
void searchstudent();
void updatestudent();
void deletestudent();
int main()
{
    int ch;
    do
    {
        printf("_____stuent management ststem______\n");
        printf("1.to save student details\n");
        printf("2.to all display student details\n");
        printf("3.to search student details\n");
        printf("4.to update student details\n");
        printf("5.to delete the stdent details\n");
        printf("6.exit\n");
        printf("enter the choice:");
        scanf("%d",&ch);
        switch(ch)
        {
            case 1:
            savestudent();
            break;
            case 2:
            displaystudent();
            break;
            case 3:
            searchstudent();
            break;
            case 4:
            updatestudent();
            break;
            case 5:
            deletestudent();
            break;
