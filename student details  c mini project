void savestudent()
{
    FILE *fp,*temp;
    fp=fopen("student details.txt","a");
    int i,n;
    printf("to save the student details\n");
    printf("how many number of student:");
    scanf("%d",&n);
    for(i=0;i<n;i++)
    {
        printf("enter the student details %d:\n",i+1);
        printf("enter the roll number:");
        scanf("%d",&r.roll_number);
        printf("enter the student name:");
        scanf("%s",r.name);
        printf("enter the student mark:");
        scanf("%f",&r.mark);
        fprintf(fp,"%d  %s  %f \n",r.roll_number,r.name,r.mark);
        
    }
    fclose(fp);
}
void displaystudent()
{
    FILE *fp;
    fp=fopen("student details.txt","r");
    printf("\n______all student_____\n");
  
    while(fscanf(fp,"%d%s%f",&r.roll_number,r.name,&r.mark)==3)
    {
        printf("roll number:%d\n",r.roll_number);
        printf("name:%s\n",r.name);
        printf("mark:%f\n",r.mark);
    }
    fclose(fp);
}
void searchstudent()
{
    FILE *fp;
    fp=fopen("student details.txt","r");
    int search,found=0;
    printf("To search the particular roll number\n");
    printf("enter the roll number to search:");
    scanf("%d",&search);
    while(fscanf(fp,"%d%s%f",&r.roll_number,r.name,&r.mark)==3)
    {
        if(r.roll_number==search)
        {
            printf("roll number:%d\n",r.roll_number);
            printf("name:%s\n",r.name);
            printf("mark:%f\n",r.mark);
            found=1;
            break;
        }
    }
    if(found==0)
    {
        printf("the search element is not found");
    }
    fclose(fp);
}
void updatestudent()
{
    FILE *fp,*temp;
    fp=fopen("student details.txt","r");
    temp=fopen("temp.txt","w");
    int searchr,foundr=0;
    printf("To update the marks\n");
    printf("enter the roll number to search:");
    scanf("%d",&searchr);
    while(fscanf(fp,"%d%s%f",&r.roll_number,r.name,&r.mark)==3)
    {
        if(r.roll_number==searchr)
        {
            printf("enter the new mark:");
            scanf("%f",&r.mark);
            foundr=1;
        }
        fprintf(temp,"%d\n%s\n%f\n",r.roll_number,r.name,r.mark);
    }    
    fclose(fp);
    fclose(temp);
    if(foundr)
    {
        remove("student details.txt");
        rename("temp.txt","student details.txt");
        printf("student mark updated!\n");
    }
    else
    {
        remove("temp.txt");
        printf("student not found\n");    
    }
}
void deletestudent()
{
    FILE *fp,*temp;
    fp=fopen("student details.txt","r");
    temp=fopen("temp.txt","w");
    int searchd,foundd=0;
    printf("to delete a particular student details\n");
    printf("enter the roll number to delete:\n");
    scanf("%d",&searchd);
    while(fscanf(fp,"%d%s%f",&r.roll_number,r.name,&r.mark)==3)
    {
        if(r.roll_number!=searchd)
        {
            fprintf(temp,"%d\n%s\n%f\n",r.roll_number,r.name,r.mark);
        }
        else
        {
            foundd=1;
        }
    }
    fclose(fp);
    fclose(temp);
    if(foundd)
    {
        remove("student details.txt");
        rename("temp.txt","student details.txt");
        printf("student detail deletion is successed\n");
    }
    else
    {
    remove("temp.txt");
    printf("student not found\n");
    }
}
